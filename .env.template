## Copy this file to ".env" and fill in values as needed.

# Secret key for Flask sessions (keep this secret in production!)
# You can use `python -c "import secrets; print(secrets.token_hex(32))"` to generate one.
SECRET_KEY=

# Sign-in. Padloper trusts the user named by the authenticating reverse proxy
# (Authelia, via nginx auth_request) in the Remote-User / Remote-Groups
# headers, but only on requests that also carry this shared secret in the
# X-Padloper-Proxy-Secret header. The proxy sets it; nothing else knows it.
# Leave empty for local development without the proxy.
PROXY_AUTH_SECRET=

# FreeIPA groups whose members become padloper admins at sign-in
# (comma-separated). Default: padloper-admins
#ADMIN_SSO_GROUPS=padloper-admins

# Where "Sign out" sends the browser after ending the padloper session.
# Default: /authelia/logout
#LOGOUT_URL=/authelia/logout

# Local development only: act as this user without the proxy. Ignored when
# PROXY_AUTH_SECRET is set.
#PADLOPER_DEV_USER=
